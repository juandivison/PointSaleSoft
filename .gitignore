# ============================================================

# POINTSALESOFT XML SALES IMPORTER

# ============================================================

# Configuración local: puede contener credenciales y rutas privadas

/PuntoVenta/PointSaleSoft.XmlSalesImporter/appsettings.json
/PuntoVenta/PointSaleSoft.XmlSalesImporter/appsettings.*.json

# Permitir archivos de configuración de ejemplo

!/PuntoVenta/PointSaleSoft.XmlSalesImporter/appsettings.example.json
!/PuntoVenta/PointSaleSoft.XmlSalesImporter/appsettings.template.json

# Publicación autocontenida

/PuntoVenta/PointSaleSoft.XmlSalesImporter/publish/
/PuntoVenta/PointSaleSoft.XmlSalesImporter/**/publish/

# Reportes y resultados generados

/PuntoVenta/PointSaleSoft.XmlSalesImporter/reports/
/PuntoVenta/PointSaleSoft.XmlSalesImporter/Reports/
/PuntoVenta/PointSaleSoft.XmlSalesImporter/logs/
/PuntoVenta/PointSaleSoft.XmlSalesImporter/Logs/
/PuntoVenta/PointSaleSoft.XmlSalesImporter/output/
/PuntoVenta/PointSaleSoft.XmlSalesImporter/Output/

# XML firmados usados como datos de operación o pruebas locales

/PuntoVenta/PointSaleSoft.XmlSalesImporter/XMLFirmados/
/PuntoVenta/PointSaleSoft.XmlSalesImporter/XmlFirmados/
/PuntoVenta/PointSaleSoft.XmlSalesImporter/xmlfirmados/
/PuntoVenta/PointSaleSoft.XmlSalesImporter/**/*_signed.xml

# Archivos generados por la importación y los reportes

/PuntoVenta/PointSaleSoft.XmlSalesImporter/**/carga_xml_*.csv
/PuntoVenta/PointSaleSoft.XmlSalesImporter/**/Ventas_XML_*.xlsx
/PuntoVenta/PointSaleSoft.XmlSalesImporter/**/*.log

# Bases de datos locales o copias de QA

/PuntoVenta/PointSaleSoft.XmlSalesImporter/**/*.fdb
/PuntoVenta/PointSaleSoft.XmlSalesImporter/**/*.fbk

