#: Fuentes/UdatosParablcgrl.dfm:430
msgid "cnt.BALANCE_ANT,"
msgstr ""

#. frmDatosblcgrl..tFuente....SQL.Strings
#: Fuentes/UdatosParablcgrl.dfm:431
msgid "cnt.SIGNO_CTA, cnt.FECHA_BLC MES_BALANCE, "
"cnt.NIVEL_CTA,"
msgstr ""

#. frmDatosblcgrl..tFuente....SQL.Strings
#: Fuentes/UdatosParablcgrl.dfm:432
msgid "cnt.TIPO_CTA"
msgstr ""

#. frmDatosblcgrl..tFuente....SQL.Strings
#: Fuentes/UdatosParablcgrl.dfm:433
msgid "FROM BALANCE_CNT cnt"
msgstr ""

#. frmDatosblcgrl..tFuente....SQL.Strings
#: Fuentes/UdatosParablcgrl.dfm:434
msgid "   INNER JOIN CATALOGO c"
msgstr ""

#. frmDatosblcgrl..tFuente....SQL.Strings
#: Fuentes/UdatosParablcgrl.dfm:435
msgid "   ON  (c.CUENTA1 = cnt.CUENTA1_BLC)  "
msgstr ""

#. frmDatosblcgrl..tFuente....SQL.Strings
#: Fuentes/UdatosParablcgrl.dfm:436
msgid "   AND  (c.CUENTA2 = cnt.CUENTA2_BLC)  "
msgstr ""

#. frmDatosblcgrl..tFuente....SQL.Strings
#: Fuentes/UdatosParablcgrl.dfm:437
msgid "   AND  (c.CUENTA3 = cnt.CUENTA3_BLC)  "
msgstr ""

#. frmDatosblcgrl..tFuente....SQL.Strings
#: Fuentes/UdatosParablcgrl.dfm:438
msgid "WHERE "
msgstr ""

#. frmDatosblcgrl..tFuente....SQL.Strings
#: Fuentes/UdatosParablcgrl.dfm:439
msgid "(c.cuenta1 between :CUENTA1INI and :CUENTA1FIN)"
msgstr ""

#. frmDatosblcgrl..tFuente....SQL.Strings
#: Fuentes/UdatosParablcgrl.dfm:440
msgid "AND (CNT.FECHA_BLC = :FECHABLC)"
msgstr ""

#. frmDatosblcgrl..tFuente....SQL.Strings
#: Fuentes/UdatosParablcgrl.dfm:441
msgid "AND (CNT.NIVEL_CTA = :NIVEL)"
msgstr ""

#. frmDatosblcgrl..tFuente....SQL.Strings
#: Fuentes/UdatosParablcgrl.dfm:442
msgid "AND (CNT.TIPO_CTA = :TIPO)"
msgstr ""

#. frmDatosblcgrl..tFuente....SQL.Strings
#: Fuentes/UdatosParablcgrl.dfm:443
msgid "AND (CNT.STATUS_CIEA = :STATUSCIEA)"
msgstr ""

#. frmDatosblcgrl..tFuente....SQL.Strings
#: Fuentes/UdatosParablcgrl.dfm:444
msgid "AND ((CNT.BALANCE_ACT NOT BETWEEN -0.004 AND 0.004) "
msgstr ""

#. frmDatosblcgrl..tFuente....SQL.Strings
#: Fuentes/UdatosParablcgrl.dfm:445
msgid "      OR (CNT.BALANCE_ANT NOT BETWEEN -0.004 AND "
"0.004))"
msgstr ""

#. frmDatosblcgrl..tFuente....SQL.Strings
#: Fuentes/UdatosParablcgrl.dfm:446
msgid "AND (CNT.BALANCE_aCT <>0 OR CNT.BALANCE_ANT <> "
"0)"
msgstr ""

