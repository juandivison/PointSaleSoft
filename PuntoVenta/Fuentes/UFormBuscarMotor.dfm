  object qryMotoresEntrada: TIBQuery
    Database = dmConectar.IBDatabase1
    Transaction = dmConectar.IBTransaction1
    BufferChunks = 1000
    CachedUpdates = False
    SQL.Strings = (
      'select  d.numero idnumeroveh, d.CODIGO_CTE, m.*,'
      'v.* '
      'from vehiculo v'
      'inner join MOTORES m on v.chassis = m.chasis '
      'inner join datosvehiculo d on d.chassis = m.chasis')
    Left = 371
    Top = 162
