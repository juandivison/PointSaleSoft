begin
    //qryVentaConduceMaster
end;

procedure TdmVentas.qryVentaConduceMasterAfterScroll(DataSet: TDataSet);
begin
  qryVentaConduce.Close;
  qryVentaConduce.Params[0].Value:= qryVentaConduceMasterNUMERO.Value;
  qryVentaConduce.Open;
end;

procedure TdmVentas.qryRepOrdenConduceAfterScroll(DataSet: TDataSet);
begin
  qryVentaFacturaDet.Close;
  qryVentaFacturaDet.Params[0].Value := dmVentas.qryRepOrdenConduceNUM_TRN.Value; //qryVentaFacturaNUMERO.Value;
  qryVentaFacturaDet.Open;

  dmFactura.qryVentaFacturaDet.Close;
  dmFactura.qryVentaFacturaDet.Params[0].Value:= dmVentas.qryRepOrdenConduceNUM_TRN.Value;
  dmFactura.qryVentaFacturaDet.Open;
end;

procedure TdmVentas.Proc_InsertarKardexDet(
    CIA_KEY : integer;
    TIPO : integer;
    TIPO_OPE :integer;
    FECHA_TRN :TDateTime;
    CODIGO_PRODUCTO :integer;
    cant : Currency;
    COSTO_PRODUCTO :real;
    PRECIO_VENTA :real;
    CODIGO_USUARIO :integer;
    NUMERO_TRN_VTA: integer;
    STATUS :string; area:string);
begin
  ibstpProc_InserKardexDet.Params[0].Value := cia_key;
  ibstpProc_InserKardexDet.Params[1].Value := tipo;
  ibstpProc_InserKardexDet.Params[2].Value := tipo_ope;
  ibstpProc_InserKardexDet.Params[3].Value := ExtraerFecha(fecha_trn);
  ibstpProc_InserKardexDet.Params[4].Value := Codigo_Producto;
  ibstpProc_InserKardexDet.Params[5].Value := Cant;
  ibstpProc_InserKardexDet.Params[6].Value := costo_producto;
  ibstpProc_InserKardexDet.Params[7].Value := precio_venta;
  ibstpProc_InserKardexDet.Params[8].Value := codigo_usuario;
  ibstpProc_InserKardexDet.Params[9].Value := numero_trn_vta;
  ibstpProc_InserKardexDet.Params[10].Value:= status;
  ibstpProc_InserKardexDet.Params[11].Value:= now;
  ibstpProc_InserKardexDet.Params[12].Value:= strusername;
  ibstpProc_InserKardexDet.Params[13].Value:= null;
  ibstpProc_InserKardexDet.Params[14].Value:= null;
  ibstpProc_InserKardexDet.Params[15].Value:= area;
  ibstpProc_InserKardexDet.ExecProc;

  if not ibstpProc_InserKardexDet.Transaction.InTransaction then
  ibstpProc_InserKardexDet.Transaction.StartTransaction;
  try
    ibstpProc_InserKardexDet.Transaction.CommitRetaining;
  except
  ibstpProc_InserKardexDet.Transaction.RollbackRetaining;
  end;
end;

procedure TdmVentas.tblDespachoDetFilterRecord(DataSet: TDataSet;
  var Accept: Boolean);
begin
  Accept:= DataSet['CODIGO_PROD'] = xcodProd;
end;

