procedure TdmVentas.tblVentasDetalleBeforePost(DataSet: TDataSet);
begin
  if tblVentasMast.State in [dsInsert] then
  tblVentasMast.Post;
end;

procedure TdmVentas.tblVentasMastAfterScroll(DataSet: TDataSet);
begin
  if tblVentasDetalle.State In [dsInactive, dsBrowse] then
  begin
    tblVentasDetalle.Close;
    tblVentasDetalle.Params[0].Value:= tblVentasMastNUMERO.Value;
    tblVentasDetalle.Open;
  end;
end;

function TdmVentas.GeneraNumFactura: integer;
begin
  dmVentas.GenNumFactura.ExecQuery;
  if dmVentas.GenNumFactura.Open then
  try
    Result:=dmVentas.GenNumFactura.Fields[0].AsInteger;
  finally
  dmventas.GenNumFactura.Close;
  end;
end;

procedure TdmVentas.tblVentasMastAfterInsert(DataSet: TDataSet);
begin
  dmVentas.tblVentasMastnumero_factura.Value :=GeneraNumFactura;//funcion
end;

procedure TdmVentas.tblRegServicioMasterAfterScroll(DataSet: TDataSet);
begin
  if tblRegServicioDet.State In [dsInsert, dsEdit] Then Exit;
  tblRegServicioDet.Close;
  tblRegServicioDet.Params[0].Value := tblRegServicioMasterNUMERO.Value;
  tblRegServicioDet.Open;
end;

procedure TdmVentas.qryRegServMasterRepAfterScroll(DataSet: TDataSet);
begin
  qryRegServMasterRepDet.Close;
  qryRegServMasterRepDet.Params[0].Value:= qryRegServMasterRepNUMERO.Value;
  qryRegServMasterRepDet.Open;
end;

procedure TdmVentas.tblDespachoMasterAfterScroll(DataSet: TDataSet);
begin
  tblDespachoDet.Close;
  tblDespachoDet.Params[0].Value:= tblDespachoMasterNUMERO.Value;
  tblDespachoDet.Open;
end;

procedure TdmVentas.tblDespachoDetCalcFields(DataSet: TDataSet);
begin
  tblDespachoDetMontoDescuento.Value:=
  tblDespachoDetVALOR_BRUTO.Value * (tblDespachoDetPORC_DESC_DET.Value/100);
end;

procedure TdmVentas.tblDespachoDetAfterScroll(DataSet: TDataSet);
begin
  if dmInventario.tblInventarioProd.State = dsBrowse then
  dmInventario.tblInventarioProd.Locate('CODIGO', tblDespachoDetCODIGO_PROD.Value,[]);
end;

procedure TdmVentas.tblOrdenTrabajoCalcFields(DataSet: TDataSet);
begin
  if (not tblOrdenTrabajoMONTO_ABONO.IsNull) then
  tblOrdenTrabajoMontoRestanteCld.Value:=
  tblOrdenTrabajoMONTO_TOTAL.Value -
  tblOrdenTrabajoMONTO_ABONO.Value
  else
  tblOrdenTrabajoMontoRestanteCld.Value:=
  tblOrdenTrabajoMONTO_TOTAL.Value;
end;

procedure TdmVentas.tblOrdenTrabajoFilterRecord(DataSet: TDataSet;
  var Accept: Boolean);
begin
  if not strFilterIsInt then
  Accept:=Dataset[strFilerFName] = strFilterValue
  else
  Accept:=Dataset[strFilerFName] = StrToInt(strFilterValue);
end;

