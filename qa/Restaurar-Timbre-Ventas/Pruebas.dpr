program Pruebas;
{$APPTYPE CONSOLE}
uses SysUtils, Classes, ActiveX, IBDatabase, IBQuery, JPEG,
  UEcfTimbreVentaLocal in '..\..\PuntoVenta\Fuentes\UEcfTimbreVentaLocal.pas',
  UUtilecf in '..\..\PuntoVenta\Fuentes\UUtilecf.pas',
  UUtilecftimbre in '..\..\PuntoVenta\Fuentes\UUtilecftimbre.pas',UGlobal,
  UDatModConectar in '..\Integracion-IDESI-PointSaleSoft\TestSupport\UDatModConectar.pas';
var D:TIBDatabase;Tx:TIBTransaction;Q:TIBQuery;L:TStringList;T:TTimbreVentaLocal;
 N:Integer;Msg,Ret,Named,Root,XmlDir,Canon,Old,Xml,C,F,Path:string;Date:TDateTime;Bad:Boolean;J:TJPEGImage;
function Valor(const S,K:string):string;var A,B:Integer;
begin A:=Pos(K+'=',S)+Length(K)+1;B:=A;while(B<=Length(S))and(S[B]<>#39)do Inc(B);Result:=Copy(S,A,B-A);end;
procedure Check(B:Boolean;const S:string);begin if not B then raise Exception.Create(S);Inc(N);WriteLn('PASS ',S);end;
procedure Exec(const S:string);
begin if not Tx.InTransaction then Tx.StartTransaction;Q.Close;Q.SQL.Text:=S;Q.ExecSQL;Tx.Commit;end;
function Scalar(const S:string):string;
begin if not Tx.InTransaction then Tx.StartTransaction;Q.Close;Q.SQL.Text:=S;Q.Open;Result:=Q.Fields[0].AsString;Q.Close;Tx.Rollback;end;
procedure Save(const FileName,Text:string);begin L.Text:=Text;L.SaveToFile(FileName);end;
function StampCount:string;begin Result:=Scalar('SELECT COUNT(*) FROM ECF_TIMBRE_LOG WHERE TRN=2');end;
begin
 CoInitialize(nil);
 try
  D:=TIBDatabase.Create(nil);Tx:=TIBTransaction.Create(nil);Q:=TIBQuery.Create(nil);L:=TStringList.Create;dmConectar:=TdmConectar.Create;
  try
   Root:=ExtractFilePath(ExpandFileName(ParamStr(0)));XmlDir:=Root+'xml-qa';ForceDirectories(XmlDir);
   Canon:=IncludeTrailingPathDelimiter(XmlDir)+'Factura_TRN2_E310000000803.xml';Old:=IncludeTrailingPathDelimiter(XmlDir)+'Factura_E31_803TRN2_signed.xml';
   L.LoadFromFile(GetEnvironmentVariable('PSS_TEST_DFM'));
   D.DatabaseName:='localhost:'+ParamStr(1);D.SQLDialect:=1;D.LoginPrompt:=False;
   D.Params.Values['user_name']:=Valor(L.Text,'user_name');D.Params.Values['password']:=Valor(L.Text,'password');D.Connected:=True;
   Tx.DefaultDatabase:=D;Tx.Params.Add('read_committed');Tx.Params.Add('rec_version');Q.Database:=D;Q.Transaction:=Tx;
   dmConectar.IBDatabase1:=D;dmConectar.IBTransaction1:=Tx;
   GlbRutaEcf:=Root+'Fixture.exe';GlbRutaQREcf:=Root+'QR_[numerotrn].jpg';
   Ret:='Ab+/12|E310000000803|21-11-2026 02:35:00|1180.00|urlImage=https://ecf.dgii.gov.do/testecf/consultatimbre?RncEmisor=999999999&ENCF=E310000000803&MontoTotal=1180.00&CodigoSeguridad=Ab%2B%2F12';
   Check(LeerRetornoTimbre(Ret,T),'retorno posicional SDK');Check(T.Monto=1180,'monto posicional exacto');
   Check(FormatDateTime('dd-mm-yyyy hh:nn:ss',T.Fecha)='21-11-2026 02:35:00','fecha fiscal conserva hora');
   Named:=StringReplace(Ret,'|21-11','|fechaEmision=21-11',[]);Named:=StringReplace(Named,'|1180.00|','|montoTotal=1180.00|',[]);
   Check(LeerRetornoTimbre(Named,T),'retorno nombrado compatible');
   Check(LeerRetornoTimbre(StringReplace(Ret,'|','%7C',[rfReplaceAll]),T),'protocolo D7T escapado');
   Check(not LeerRetornoTimbre(StringReplace(Ret,'21-11-2026 02:35:00','',[]),T),'fecha ausente no se sustituye por Now');
   Check(NombreXmlFirmadoVenta(2,'E310000000803')='Factura_TRN2_E310000000803.xml','nombre XML con TRN y eNCF completo una vez');
   Check(LeerRetornoTimbre(Ret,T),'recarga retorno valido');
   Check(GuardarTimbreVentaLocal(D,2,T),'repara fila existente con nulos');
   Check(StampCount='1','reparacion no duplica registro');
   Check(Scalar('SELECT CODIGO_SEGURIDAD FROM ECF_TIMBRE_LOG WHERE TRN=2')='Ab+/12','codigo de seguridad persistido');
   Check(Scalar('SELECT MONTO_TOTAL FROM ECF_TIMBRE_LOG WHERE TRN=2')<>'0','monto no se degrada a cero');
   Check(GuardarTimbreVentaLocal(D,2,T)and(StampCount='1'),'segunda validacion idempotente');
   Check(EjecutarECF_y_Mostrar(GlbRutaEcf,'2',Msg),'ruta normal con proveedor simulado sin HTTP');
   Check(Pos('pendiente',LowerCase(Msg))=0,'D7T anterior a D7 no se pierde');
   Path:=GetUrlImageTimbre(2,C,F);Check((Path=T.Url)and(C=T.Codigo),'impresion lee QR y codigo de tabla');
   Check(Pos('02:35:00',F)>0,'impresion lee FECHA_EMISION y no FECHA_CREACION');
   Tx.StartTransaction;Q.SQL.Text:='INSERT INTO COMPANIA VALUES(9,''NO_COMMIT'')';Q.ExecSQL;
   Check(GuardarTimbreVentaLocal(D,2,T),'persistencia usa transaccion independiente');
   Check(Tx.InTransaction,'transaccion de pantalla sigue activa');Tx.Rollback;
   Check(Scalar('SELECT COUNT(*) FROM COMPANIA WHERE CODIGO=9')='0','no confirma negocio pendiente de pantalla');
   T.Encf:='E310000000804';T.Url:=StringReplace(T.Url,'803','804',[rfReplaceAll]);Bad:=False;
   try GuardarTimbreVentaLocal(D,2,T);except on E:Exception do Bad:=True;end;
   Check(Bad,'timbre de otro eNCF rechazado');Check(StampCount='1','rechazo conserva registro');
   Save(Root+'estandar_appsettings.json','{"DGII":{"RncEmisor":"999999999","Ambiente":"testecf","OutputXmlFirmed":"'+StringReplace(XmlDir,'\','\\',[rfReplaceAll])+'","EnableDateDirArtifacts":false}}');
   Xml:='<ECF><Encabezado><IdDoc><eNCF>E310000000803</eNCF></IdDoc><Emisor><RNCEmisor>999999999</RNCEmisor><FechaEmision>21-11-2026</FechaEmision></Emisor>'+
     '<Totales><MontoTotal>1180.00</MontoTotal></Totales></Encabezado><FechaHoraFirma>21-11-2026 02:35:00</FechaHoraFirma><Signature xmlns="http://www.w3.org/2000/09/xmldsig#"><SignatureValue>Ab+/12QA</SignatureValue></Signature></ECF>';
   Save(Old,Xml);Save(Canon,Xml);
   Exec('UPDATE ECF_TIMBRE_LOG SET CODIGO_SEGURIDAD=NULL,URL_IMAGE=NULL,FECHA_EMISION=NULL,MONTO_TOTAL=NULL WHERE TRN=2');
   Check(RestaurarTimbreVentaLocal(D,2,GlbRutaEcf,'',Msg),'recupera timbre desde XML firmado local');
   Check(FileExists(Canon)and FileExists(Old),'lectura local conserva XML anteriores sin renombrarlos');
   FileSetDate(Old,DateTimeToFileDate(Now-1));
   Path:=XmlDir+'\Factura_E31_310000000803_signed.xml';Date:=Now-1/86400;Save(Path,Xml);
   Check(RestaurarTimbreVentaLocal(D,2,GlbRutaEcf,'',Msg,Date),'valida artefacto de descarga nueva');
   Check(not FileExists(Path)and FileExists(Canon),'solo nueva descarga adopta nombre TRN eNCF');
   Check(FileExists(Old),'normalizacion nueva no toca XML anterior');
   DeleteFile(Old);
   Check(StampCount='1','recuperacion XML repara sin duplicar');
   Check(Scalar('SELECT CODIGO_SEGURIDAD FROM ECF_TIMBRE_LOG WHERE TRN=2')='Ab+/12','XML conserva caracteres base64');
   Exec('UPDATE ECF_TIMBRE_LOG SET CODIGO_SEGURIDAD=NULL,URL_IMAGE=NULL,FECHA_EMISION=NULL,MONTO_TOTAL=NULL WHERE TRN=2');
   Path:=GetUrlImageTimbre(2,C,F);Check((Path<>'')and(C='Ab+/12'),'reimpresion repara automaticamente fila incompleta');
   Path:=GetRutaTimbre(2,C,F);Check(FileExists(Path),'Delphi regenera imagen QR');
   J:=TJPEGImage.Create;try J.LoadFromFile(Path);Check((J.Width>100)and(J.Height>100),'QR generado es JPEG legible por impresion');finally J.Free;end;
   Check(RestaurarTimbrePorEncf(D,'E310000000803',GlbRutaEcf,Msg),'descarga por eNCF valida y repara el mismo documento');
   FileSetDate(Canon,DateTimeToFileDate(Now-1));Date:=Now;
   Exec('UPDATE ECF_TIMBRE_LOG SET CODIGO_SEGURIDAD=NULL,URL_IMAGE=NULL,FECHA_EMISION=NULL,MONTO_TOTAL=NULL WHERE TRN=2');
   Check(RestaurarTimbrePorEncf(D,'E310000000803',GlbRutaEcf,Msg,Date),'QRDown recupera XML existente sin nueva descarga');
   Check(FileExists(Canon)and(FileDateToDateTime(FileAge(Canon))<Date),'recuperacion conserva nombre y fecha del XML anterior');
   Check(Scalar('SELECT CODIGO_SEGURIDAD FROM ECF_TIMBRE_LOG WHERE TRN=2')='Ab+/12','XML existente completa timbre incompleto');
   RenameFile(Canon,Canon+'.qa-backup');
   try
    Check(not RestaurarTimbrePorEncf(D,'E310000000803',GlbRutaEcf,Msg,Now),'XML ausente queda pendiente sin reemision');
    Check((Pos(XmlDir,Msg)>0)and(Pos('No reenviar',Msg)>0),'aviso indica carpeta exacta y evita reenvio');
   finally RenameFile(Canon+'.qa-backup',Canon);end;
   Save(Old,Xml+' ');Bad:=False;try RestaurarTimbreVentaLocal(D,2,GlbRutaEcf,'',Msg);except on E:Exception do Bad:=True;end;
   Check(Bad and FileExists(Old)and FileExists(Canon),'XML diferentes se conservan para conciliacion');DeleteFile(Old);
   Save(Canon,StringReplace(Xml,'999999999','888888888',[rfReplaceAll]));Bad:=False;
   try RestaurarTimbreVentaLocal(D,2,GlbRutaEcf,'',Msg);except on E:Exception do Bad:=True;end;
   Check(Bad,'XML de otro RNC rechazado');Check(Scalar('SELECT CODIGO_SEGURIDAD FROM ECF_TIMBRE_LOG WHERE TRN=2')='Ab+/12','rechazo conserva timbre bueno');Save(Canon,Xml);
   Save(Canon,StringReplace(Xml,'SignatureValue','NoSignature',[rfReplaceAll]));Bad:=False;
   try RestaurarTimbreVentaLocal(D,2,GlbRutaEcf,'',Msg);except on E:Exception do Bad:=True;end;
   Check(Bad,'XML sin firma rechazado');Save(Canon,Xml);
   Check(Scalar('SELECT DGII_STATUS FROM NCF_ASIGNADOS WHERE SERIE=1')='ACEPTADO','reparacion no altera estado fiscal');
   Check(Scalar('SELECT NUMERO_NCF FROM NCF_ASIGNADOS WHERE SERIE=1')='E310000000803','no consume ni reasigna secuencia');
   Exec('UPDATE NCF_ASIGNADOS SET DGII_STATUS=''RECHAZADO'' WHERE SERIE=1');
   Check(not RestaurarTimbreVentaLocal(D,2,GlbRutaEcf,'',Msg),'XML local no convierte rechazo en timbre aceptado');
   Exec('UPDATE NCF_ASIGNADOS SET DGII_STATUS=''ACEPTADO'' WHERE SERIE=1');
   Save(XmlDir+'\Factura_TRN3_E320000000001.xml',StringReplace(StringReplace(Xml,'E310000000803','E320000000001',[rfReplaceAll]),'1180.00','1500.00',[rfReplaceAll]));
   Check(RestaurarTimbreVentaLocal(D,3,GlbRutaEcf,'',Msg),'E32 inserta timbre nuevo desde XML local');
   Path:=GetUrlImageTimbre(3,C,F);
   Check(Pos('https://fc.dgii.gov.do/testecf/consultatimbrefc?',Path)=1,'E32 consumo usa ruta FC');
   Check((Pos('FechaFirma=',Path)=0)and(Pos('FechaEmision=',Path)=0),'E32 consumo mantiene URL reducida');
   Check(Pos('02:35:00',F)>0,'E32 conserva hora de firma disponible');
   Check(LeerRetornoTimbre(Ret,T),'recarga timbre para conflicto');
   T.Codigo:='ZZZZZZ';T.Url:=StringReplace(T.Url,'Ab%2B%2F12','ZZZZZZ',[]);Bad:=False;
   try GuardarTimbreVentaLocal(D,2,T);except on E:Exception do Bad:=True;end;
   Check(Bad,'no reemplaza timbre completo por otro codigo');
   Exec('UPDATE ECF_TIMBRE_LOG SET URL_IMAGE=''https://ecf.dgii.gov.do/testecf/consultatimbre?RncEmisor=999999999&ENCF=E310000000804&MontoTotal=1180&CodigoSeguridad=Ab%2B%2F12'' WHERE TRN=2');
   Check(GetUrlImageTimbre(2,C,F)='','impresion rechaza URL de otra factura');
   Check(LeerRetornoTimbre(Ret,T)and GuardarTimbreVentaLocal(D,2,T),'restaura fixture valido tras prueba negativa');
   Check(Scalar('SELECT TRACK_ID FROM NCF_ASIGNADOS WHERE SERIE=1')='QA-NO-HTTP','ruta normal persiste TrackId en NCF_ASIGNADOS');
   Check(Scalar('SELECT DGII_MENSAJE FROM NCF_ASIGNADOS WHERE SERIE=1')='OK','ruta normal persiste mensaje fiscal');
   Check(Scalar('SELECT COUNT(*) FROM NCF_ASIGNADOS WHERE SERIE=1 AND ULTIMO_INTENTO IS NOT NULL')='1','procedimiento fiscal actualiza auditoria local');
   PersistirResultadoFiscalVenta(D,2,'E310000000803','ACEPTADO','','OK');
   Check(Scalar('SELECT TRACK_ID FROM NCF_ASIGNADOS WHERE SERIE=1')='QA-NO-HTTP','respuesta sin TrackId conserva historial existente');
   Bad:=False;try PersistirResultadoFiscalVenta(D,2,'E310000000803','EN PROCESO','','anterior');except on E:Exception do Bad:=True;end;
   Check(Bad and(Scalar('SELECT DGII_STATUS FROM NCF_ASIGNADOS WHERE SERIE=1')='ACEPTADO'),'respuesta antigua no degrada aceptado');
   Bad:=False;try PersistirResultadoFiscalVenta(D,2,'E310000000804','ACEPTADO','OTRO','');except on E:Exception do Bad:=True;end;
   Check(Bad,'resultado NCF de otra factura rechazado');
   Bad:=False;try PersistirResultadoFiscalVenta(D,2,'E310000000803','ACEPTADO','OTRO','');except on E:Exception do Bad:=True;end;
   Check(Bad and(Scalar('SELECT TRACK_ID FROM NCF_ASIGNADOS WHERE SERIE=1')='QA-NO-HTTP'),'otro TrackId no reemplaza el confirmado');
   Exec('UPDATE NCF_ASIGNADOS SET DGII_STATUS=NULL,TRACK_ID=NULL WHERE SERIE=2');
   PersistirResultadoFiscalVenta(D,3,'E320000000001','EN PROCESO','QA-E32','Procesando');
   Check(Scalar('SELECT DGII_STATUS FROM NCF_ASIGNADOS WHERE SERIE=2')='EN PROCESO','estado en proceso queda persistido');
   PersistirResultadoFiscalVenta(D,3,'E320000000001','RECHAZADO','QA-E32','Rechazo QA');
   Check(Scalar('SELECT DGII_STATUS FROM NCF_ASIGNADOS WHERE SERIE=2')='RECHAZADO','rechazo fiscal queda persistido');
   Check(Scalar('SELECT DGII_MENSAJE FROM NCF_ASIGNADOS WHERE SERIE=2')='Rechazo QA','reporte conserva motivo de rechazo');
   Exec('UPDATE NCF_ASIGNADOS SET DGII_STATUS=NULL WHERE SERIE=2');
   Bad:=False;try PersistirResultadoFiscalVenta(D,3,'E320000000001','EN PROCESO','QA-E32','QA_FAIL');except on E:Exception do Bad:=True;end;
   Check(Bad and(Scalar('SELECT COUNT(*) FROM NCF_ASIGNADOS WHERE SERIE=2 AND DGII_STATUS IS NULL')='1'),'detecta procedimiento que no persiste y revierte');
   Exec('UPDATE NCF_ASIGNADOS SET DGII_STATUS=''ACEPTADO'' WHERE SERIE=2');
   L.LoadFromFile(Root+'estandar_appsettings.json');L.Text:=StringReplace(L.Text,'"Ambiente":"testecf"','"Ambiente":"https://api.aslan.com.do/TesteCF/","AmbienteTipo":"Test"',[]);L.SaveToFile(Root+'estandar_appsettings.json');
   Check(RestaurarTimbreVentaLocal(D,2,GlbRutaEcf,'',Msg),'recuperacion admite configuracion ASLAN Test existente');
   Exec('UPDATE NCF_ASIGNADOS SET DGII_STATUS=NULL WHERE SERIE=1');
   Save(Root+'persist-fail.flag','QA');
   try
    Check(EjecutarECF_y_Mostrar(GlbRutaEcf,'2',Msg),'falla local conserva resultado fiscal aceptado');
    Check(Pos('Persistencia Firebird pendiente',Msg)>0,'fallo de persistencia queda explicito en resultado');
    Check(Scalar('SELECT COUNT(*) FROM NCF_ASIGNADOS WHERE SERIE=1 AND DGII_STATUS IS NULL')='1','fallo local no inventa estado en base');
   finally DeleteFile(Root+'persist-fail.flag');end;
   Check(EjecutarECF_y_Mostrar(GlbRutaEcf,'2',Msg),'recuperacion de persistencia con proveedor simulado');
   Check(Scalar('SELECT DGII_STATUS FROM NCF_ASIGNADOS WHERE SERIE=1')='ACEPTADO','estado fiscal queda guardado tras recuperacion');
   WriteLn('RESTAURACION_TIMBRE_DELPHI=PASS; CHECKS=',N,'; HTTP=0; MOTOR_MODIFICADO=0; BASE_COMERCIAL=0');
  finally if Tx.InTransaction then Tx.Rollback;Q.Free;Tx.Free;D.Free;L.Free;dmConectar.Free;dmConectar:=nil;end;
 except on E:Exception do begin WriteLn('FAIL ',E.Message);Halt(1);end;end;
 CoUninitialize;
end.
