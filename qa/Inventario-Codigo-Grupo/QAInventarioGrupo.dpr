program QAInventarioGrupo;
{$APPTYPE CONSOLE}
uses Windows, SysUtils, Classes, Forms, Controls, StdCtrls, DB,
  IBDatabase, IBQuery, IBCustomDataSet, UInventarioCodigoGrupo;
type
  TOriginal = class
    Antes, Despues, Nuevos: Integer;
    procedure BeforePost(D: TDataSet);
    procedure AfterPost(D: TDataSet);
    procedure OnNewRecord(D: TDataSet);
  end;
var DB1,DB2:TIBDatabase; Tx1,Tx2:TIBTransaction; Datos:TIBDataSet;
 Q:TIBQuery; F:TForm; Control:TInventarioCodigoGrupo; Combo:TComboBox;
 Original:TOriginal; L:TStringList; P,S,Base,Cred:string; N,Checks,I:Integer;
 Fallo:Boolean;
procedure Check(Valor:Boolean; const Nombre:string);
begin if not Valor then raise Exception.Create(Nombre);Inc(Checks);WriteLn('PASS ',Nombre);end;
procedure TOriginal.BeforePost(D:TDataSet);
begin Inc(Antes); if D.FieldByName('DESCRIPCION').AsString='INVALIDO' then
 raise Exception.Create('VALIDACION_ORIGINAL');end;
procedure TOriginal.AfterPost(D:TDataSet);begin Inc(Despues);end;
procedure TOriginal.OnNewRecord(D:TDataSet);begin Inc(Nuevos);D.FieldByName('PRECIO').AsFloat:=12.5;end;
function Valor(const Texto,Clave:string):string;
var A,B:Integer;
begin A:=Pos(Clave+'=',Texto)+Length(Clave)+1;B:=A;
 while(B<=Length(Texto))and(Texto[B]<>#39)do Inc(B);Result:=Copy(Texto,A,B-A);end;
procedure Conectar(var D:TIBDatabase;var T:TIBTransaction);
begin
 D:=TIBDatabase.Create(nil);T:=TIBTransaction.Create(nil);T.DefaultDatabase:=D;
 T.Params.Text:='read_committed'+#13#10+'rec_version'+#13#10+'nowait';
 D.DefaultTransaction:=T;D.DatabaseName:='localhost:'+Base;D.SQLDialect:=1;D.LoginPrompt:=False;
 D.Params.Values['user_name']:=Valor(Cred,'user_name');D.Params.Values['password']:=Valor(Cred,'password');
 D.Connected:=True;
end;
procedure Guardar;
begin Datos.Post;Datos.ApplyUpdates;Tx1.CommitRetaining;end;
procedure Insertar(const Sql:string);
begin Q.Close;Q.SQL.Text:=Sql;Q.ExecSQL;Tx2.CommitRetaining;end;
procedure Rechaza(const Codigo,Grupo:string;ID:Integer;const Nombre:string);
begin Fallo:=False;try ValidarCodigoGrupo(DB1,Tx1,Codigo,Grupo,ID,False);
 except on E:Exception do Fallo:=True;end;Check(Fallo,Nombre);end;
begin
 try
  Application.Initialize;
  L:=TStringList.Create;
  L.LoadFromFile('base.txt');Base:=Trim(L.Text);
  L.LoadFromFile(GetEnvironmentVariable('PSS_TEST_DFM'));Cred:=L.Text;
  Conectar(DB1,Tx1);Conectar(DB2,Tx2);Cred:='';
  Check(PrefijoGrupo(' p010001 ')='F10001','normaliza familia P/F y ceros');
  Check(PrefijoGrupo('F0')='','rechaza grupo cero');
  Check(PrefijoGrupo('F-1')='','rechaza prefijo con guion');
  Check(PrefijoGrupo('F10001 OR 1=1')='','rechaza texto SQL');
  Check(SepararCodigoGrupo('P10001-40',P,N)and(P='F10001')and(N=40),'descompone codigo importado');
  Check(not SepararCodigoGrupo('F10001-0',P,N),'rechaza secuencia cero');
  Check(not SepararCodigoGrupo('F10001--1',P,N),'rechaza negativos');
  Check(not SepararCodigoGrupo('F10001-1x',P,N),'rechaza sufijo no numerico');
  Check(not SepararCodigoGrupo('F10001-2147483648',P,N),'rechaza desborde');
  Check(SiguienteCodigoGrupo(DB1,Tx1,'F10001')='F10001-41','maximo numerico 40 frente a 9');
  Check(SiguienteCodigoGrupo(DB1,Tx1,'P10001')='F10001-41','continua familia importada');
  Check(SiguienteCodigoGrupo(DB1,Tx1,'F11000')='F11000-1','grupo sin productos inicia uno');
  Check(SiguientePrefijoGrupo(DB1,Tx1)='F10062','nuevo prefijo desde maximo global');
  Rechaza('F10001-40','F10001',-1,'evita repetir sufijo P con F');
  Rechaza('F10001-041','F10061',-1,'evita codigo de otro grupo');
  Rechaza('F10001-040','F10001',-1,'evita duplicar mediante ceros');
  ValidarCodigoGrupo(DB1,Tx1,'P10001-40','F10001',2,False);Check(True,'excluye propio registro');
  Q:=TIBQuery.Create(nil);Q.Database:=DB2;Q.Transaction:=Tx2;
  Insertar('INSERT INTO INVENTARIO_PRODUCTO(CODIGO,CODIGO_TEXTO) VALUES(4,''F10001-41'')');
  Check(SiguienteCodigoGrupo(DB1,Tx1,'F10001')='F10001-42','consulta ve altas de otra conexion');
  ValidarCodigoGrupo(DB1,Tx1,'F10001-42','F10001',-1,True);
  Fallo:=False;try ValidarCodigoGrupo(DB2,Tx2,'F10061-4','F10061',-1,True);
  except on E:Exception do Fallo:=Pos('Otro usuario',E.Message)>0;end;
  Check(Fallo,'dos conexiones no guardan simultaneamente la misma sugerencia');
  Tx1.Commit;Tx2.Rollback;
  ValidarCodigoGrupo(DB2,Tx2,'F10061-4','F10061',-1,True);Tx2.Rollback;
  Check(True,'bloqueo liberado al terminar transaccion');
  F:=TForm.CreateNew(nil);Datos:=TIBDataSet.Create(nil);Datos.Database:=DB1;Datos.Transaction:=Tx1;
  Datos.CachedUpdates:=True;
  Datos.SelectSQL.Text:='SELECT * FROM INVENTARIO_PRODUCTO ORDER BY CODIGO';
  Datos.InsertSQL.Text:='INSERT INTO INVENTARIO_PRODUCTO(CODIGO,CODIGO_TEXTO,CODIGO_BARRA,TIPO,DESCRIPCION,CANTIDAD,PRECIO) '+
   'VALUES(:CODIGO,:CODIGO_TEXTO,:CODIGO_BARRA,:TIPO,:DESCRIPCION,:CANTIDAD,:PRECIO)';
  Datos.ModifySQL.Text:='UPDATE INVENTARIO_PRODUCTO SET CODIGO_TEXTO=:CODIGO_TEXTO,CODIGO_BARRA=:CODIGO_BARRA,'+
   'TIPO=:TIPO,DESCRIPCION=:DESCRIPCION,CANTIDAD=:CANTIDAD,PRECIO=:PRECIO WHERE CODIGO=:OLD_CODIGO';
  Datos.RefreshSQL.Text:='SELECT * FROM INVENTARIO_PRODUCTO WHERE CODIGO=:CODIGO';
  Datos.GeneratorField.Field:='CODIGO';Datos.GeneratorField.Generator:='GEN_NUM_INV_PROD';
  Datos.GeneratorField.ApplyEvent:=gamOnPost;
  Original:=TOriginal.Create;Datos.BeforePost:=Original.BeforePost;Datos.AfterPost:=Original.AfterPost;
  Datos.OnNewRecord:=Original.OnNewRecord;
  Datos.Open;Datos.Locate('CODIGO',2,[]);
  Control:=TInventarioCodigoGrupo.Create(F,F,Datos);
  Combo:=TComboBox(Control.FindComponent('cmbGrupoCodigoFerreteria'));
  Check(Assigned(Combo)and(Combo.Text='F10001'),'selector reconoce grupo del producto actual');
  Datos.Insert;
  Check(Datos.FieldByName('TIPO').AsInteger=1,'nuevo producto tipo Bienes');
  Check(Original.Nuevos=1,'conserva evento OnNewRecord original');
  Check(Datos.FieldByName('PRECIO').AsFloat=12.5,'conserva precio inicial original');
  Check(Datos.FieldByName('CODIGO_TEXTO').AsString='F10001-42','sugiere al insertar grupo actual');
  Datos.FieldByName('CANTIDAD').AsFloat:=7;
  Datos.FieldByName('DESCRIPCION').AsString:='NUEVO';Guardar;
  Check(Datos.FieldByName('CODIGO').AsInteger=501,'generador original numerico');
  Check(Datos.FieldByName('CODIGO_BARRA').AsString='501','barra vacia toma codigo numerico');
  Check(Datos.FieldByName('CODIGO_TEXTO').AsString='F10001-42','codigo texto independiente del generador');
  Check(Datos.FieldByName('CANTIDAD').AsFloat=7,'cantidad preservada');
  Check(Datos.FieldByName('PRECIO').AsFloat=12.5,'precio preservado al guardar');
  Check((Original.Antes>=1)and(Original.Despues>=1),'conserva eventos originales de guardado');
  Datos.Insert;Datos.FieldByName('CODIGO_BARRA').AsString:='7890123456789';
  Datos.FieldByName('DESCRIPCION').AsString:='BARRA MANUAL';Guardar;
  Check(Datos.FieldByName('CODIGO_BARRA').AsString='7890123456789','preserva barra escrita por usuario');
  Datos.Insert;Datos.FieldByName('CODIGO_TEXTO').AsString:='F10001-60';
  Datos.FieldByName('DESCRIPCION').AsString:='CODIGO MANUAL';Guardar;
  Check(Datos.FieldByName('CODIGO_TEXTO').AsString='F10001-60','respeta consecutivo manual libre');
  Datos.Insert;Check(Datos.FieldByName('CODIGO_TEXTO').AsString='F10001-61','continua despues de codigo manual');
  Datos.FieldByName('CODIGO_TEXTO').AsString:='F10061-4';
  Fallo:=False;try Datos.Post;except on E:Exception do Fallo:=Pos('grupo seleccionado',E.Message)>0;end;
  Check(Fallo and(Datos.State=dsInsert),'rechaza cambio manual a otro grupo sin perder edicion');Datos.Cancel;
  Datos.Insert;Datos.FieldByName('CODIGO_TEXTO').AsString:='F10001-40';
  Fallo:=False;try Datos.Post;except on E:Exception do Fallo:=Pos('otro producto',E.Message)>0;end;
  Check(Fallo,'rechaza duplicado manual en evento real');Datos.Cancel;
  Datos.Insert;Datos.FieldByName('DESCRIPCION').AsString:='INVALIDO';
  Fallo:=False;try Datos.Post;except on E:Exception do Fallo:=E.Message='VALIDACION_ORIGINAL';end;
  Check(Fallo,'validacion anterior sigue activa');Datos.Cancel;
  Datos.Insert;
  Check(Datos.FieldByName('CODIGO_TEXTO').AsString='F10001-61','sugerencia antes de alta simultanea');
  Insertar('INSERT INTO INVENTARIO_PRODUCTO(CODIGO,CODIGO_TEXTO) VALUES(100,''F10001-61'')');
  Datos.FieldByName('DESCRIPCION').AsString:='OTRO PUESTO';Guardar;
  Check(Datos.FieldByName('CODIGO_TEXTO').AsString='F10001-62','recalcula sugerencia ocupada por otra terminal');
  Datos.Insert;Datos.FieldByName('DESCRIPCION').AsString:='PENDIENTE UNO';Datos.Post;
  Check(Datos.FieldByName('CODIGO_TEXTO').AsString='F10001-63','primer Post pendiente recibe siguiente');
  Datos.Insert;
  Check(Datos.FieldByName('CODIGO_TEXTO').AsString='F10001-64','segunda alta cuenta pendiente sin ApplyUpdates');
  Datos.FieldByName('DESCRIPCION').AsString:='PENDIENTE DOS';Datos.Post;
  Datos.Insert;Datos.FieldByName('CODIGO_TEXTO').AsString:='F10001-63';
  Fallo:=False;try Datos.Post;except on E:Exception do Fallo:=Pos('pendiente',E.Message)>0;end;
  Check(Fallo,'codigo manual no duplica otro registro pendiente');Datos.Cancel;
  Datos.ApplyUpdates;Tx1.CommitRetaining;
  Q.SQL.Text:='SELECT COUNT(*) FROM INVENTARIO_PRODUCTO WHERE CODIGO_TEXTO IN (''F10001-63'',''F10001-64'')';
  Q.Open;Check(Q.Fields[0].AsInteger=2,'ambos pendientes persisten distintos');Q.Close;Tx2.Rollback;
  Datos.Locate('CODIGO',2,[]);Datos.Edit;Datos.FieldByName('DESCRIPCION').AsString:='HISTORICO';Guardar;
  Check(Datos.FieldByName('CODIGO_TEXTO').AsString='P10001-40','editar precio o descripcion conserva codigo historico');
  Datos.Edit;Datos.FieldByName('CODIGO_TEXTO').AsString:='F10061-10';
  Fallo:=False;try Datos.Post;except on E:Exception do Fallo:=True;end;
  Check(Fallo,'edicion manual no invade otro grupo');Datos.Cancel;
  Datos.Insert;Datos.FieldByName('CODIGO_TEXTO').Clear;Combo.Text:='F10061';
  Datos.FieldByName('DESCRIPCION').AsString:='CLON';Guardar;
  Check(Datos.FieldByName('CODIGO_TEXTO').AsString='F10061-4','clon con codigo limpio recibe grupo seleccionado');
  Datos.Insert;Datos.FieldByName('CODIGO_TEXTO').AsString:='P10061-05';
  Datos.FieldByName('DESCRIPCION').AsString:='NORMALIZADO';Guardar;
  Check(Datos.FieldByName('CODIGO_TEXTO').AsString='F10061-5','nuevas altas normalizan a F');
  Datos.Insert;Datos.Post;Datos.CancelUpdates;
  Datos.Insert;Combo.Text:='F10061';Combo.OnSelect(Combo);
  Check(Datos.FieldByName('CODIGO_TEXTO').AsString='F10061-6','cancelar cambios libera sugerencias pendientes');Datos.Cancel;
  Control.Free;
  Check(TMethod(Datos.BeforePost).Data=Original,'restaura BeforePost al cerrar controlador');
  Check(TMethod(Datos.AfterPost).Data=Original,'restaura AfterPost al cerrar controlador');
  Check(TMethod(Datos.OnNewRecord).Data=Original,'restaura OnNewRecord al cerrar controlador');
  Datos.Free;F.Free;Original.Free;Q.Free;DB2.Free;Tx2.Free;DB1.Free;Tx1.Free;L.Free;
  WriteLn('INVENTARIO_GRUPO=PASS; CASOS=',Checks,'; BASE_COMERCIAL_MODIFICADA=0');
 except on E:Exception do begin WriteLn('FAIL ',E.Message);Halt(1);end;end;
end.
