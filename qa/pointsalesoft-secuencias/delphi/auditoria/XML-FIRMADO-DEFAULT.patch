+using IdesiToolECF.Services.Gastos;
+using Microsoft.Extensions.Configuration;
+int checks=0;
+foreach (var item in new (string value, bool expected)[] { (null,true),("",true),("true",true),("false",false),("1",true),("0",false),("off",false),(" yes ",true) }) {
+ var config=new ConfigurationBuilder().AddInMemoryCollection(new Dictionary<string,string?>{{"DGII:RetrieveSignedXmlOnAccept",item.value}}).Build();
+ if(GastoArtifactOptions.RetrieveSignedXmlOnAccept(config)!=item.expected) throw new Exception("Configuracion incorrecta"); checks++;
+}
+try { GastoArtifactOptions.RetrieveSignedXmlOnAccept(new ConfigurationBuilder().AddInMemoryCollection(new Dictionary<string,string?>{{"DGII:RetrieveSignedXmlOnAccept","incorrecto"}}).Build()); throw new Exception("No rechazo parametro invalido"); } catch(InvalidOperationException){checks++;}
+Console.WriteLine($"PASS {checks} casos: descarga por defecto y desactivacion explicita; sin red ni envio fiscal.");
