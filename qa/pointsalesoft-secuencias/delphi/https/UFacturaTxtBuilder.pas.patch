@@ -247,0 +260 @@ function TFacturaTxtBuilder.LoadMaster(const ANumeroTransaccion: Integer): TIBQu
+var Reserva: TIBQuery;
@@ -248,0 +262,2 @@ begin
+  FUsaReservaRemota := False;
+  FFechaReservaRemota := 0;
@@ -256,0 +272,33 @@ begin
+  try
