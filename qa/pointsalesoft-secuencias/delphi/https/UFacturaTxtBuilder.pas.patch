+          if not Reserva.Eof then
+            raise EFacturaTxtBuilder.Create('Varias solicitudes remotas para la venta.');
+        end;
+      end;
+    finally
+      Reserva.Free;
+    end;
+  except
+    Result.Free;
+    raise;
+  end;
