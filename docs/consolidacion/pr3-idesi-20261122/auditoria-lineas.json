      "program GastosPersistenciaQA;",
      "{$APPTYPE CONSOLE}",
      "uses SysUtils, Classes, IBDatabase, IBQuery, IBCustomDataSet, UEcfGuardarDataset, UGlobal in 'TestSupport\\UGlobal.pas',",
      "UUtilecfGastos, UEcfEnvioGastos in 'UEcfEnvioGastos.pas';",
      "function DfmValue(const S,N:string):string;",
      "var P,F:Integer;",
      "begin P:=Pos(N+'=',S);if P=0 then raise Exception.Create('Configuracion ausente');Inc(P,Length(N)+1);F:=P;while (F<=Length(S)) and (S[F]<>#39) do Inc(F);Result:=Copy(S,P,F-P);end;",
      "procedure Check(B:Boolean;const N:string);",
      "begin if not B then raise Exception.Create(N);WriteLn('PASS ',N);end;",
      "var D:TIBDatabase;T:TIBTransaction;Q:TIBQuery;S:TStringList;R:TGastoEcfCliResult;",
      "Data:TIBDataSet; I,Id:Integer;Tipo,Encf,Hash,Stage:string;Conflict:Boolean;",
      "begin",
      "if ParamCount<>2 then begin WriteLn('Uso: GastosPersistenciaQA archivo_datos.dfm base_qa.fdb');Halt(2);end;",
      "D:=TIBDatabase.Create(nil);T:=TIBTransaction.Create(nil);Q:=TIBQuery.Create(nil);S:=TStringList.Create;Stage:='conexion';Id:=-1900000000-Random(999999);",
      "try",
      "try",
      "S.LoadFromFile(ParamStr(1));",
      "D.DatabaseName:='localhost:'+ParamStr(2);D.SQLDialect:=1;D.LoginPrompt:=False;",
      "D.Params.Values['user_name']:=DfmValue(S.Text,'user_name');D.Params.Values['password']:=DfmValue(S.Text,'password');S.Clear;D.Connected:=True;",
      "T.DefaultDatabase:=D;T.Params.Add('read_committed');T.Params.Add('rec_version');Q.Database:=D;Q.Transaction:=T;",
      "for I:=1 to 2 do begin",
      "if I=1 then Tipo:='41' else Tipo:='43';Encf:='E'+Tipo+'9999999991';Hash:=Format('GASTO|CIA=%d|TRN=%d|TIPO=%s',[Id,Id,Tipo]);",
      "Stage:='preparar';T.StartTransaction;",
      "Q.SQL.Text:='SELECT COUNT(*) N FROM ECF_RESERVA WHERE NCF=:N';Q.ParamByName('N').AsString:=Encf;Q.Open;Check(Q.FieldByName('N').AsInteger=0,'e-NCF sintetico disponible');Q.Close;",
      "Q.SQL.Text:='INSERT INTO ECF_RESERVA(ID,HASH_DOC,SERIE,TIPO_CF,CORRELATIVO,NCF,ESTADO,CREATED_AT) VALUES(:I,:H,''E'',:TIPO,9999999991,:N,''RESERVADO'',CURRENT_TIMESTAMP)';",
      "Q.ParamByName('I').AsInteger:=Id-I;Q.ParamByName('H').AsString:=Hash;Q.ParamByName('TIPO').AsInteger:=StrToInt(Tipo);Q.ParamByName('N').AsString:=Encf;Q.ExecSQL;T.Commit;",
      "R.Estado:='RECHAZADO';R.Mensaje:=StringOfChar('M',1600);R.SalidaCompleta:='Respuesta QA completa';R.TrackId:='QA-TRACK';R.ENCF:=Encf;R.TieneTimbre:=False;",
      "Stage:='persistir';PersistirResultadoEcfGasto(D,Id,Id,Tipo,Encf,R);",
      "T.StartTransaction;Q.SQL.Text:='SELECT ESTADO,CHAR_LENGTH(MENSAJE) L FROM ECF_RESERVA WHERE ID=:I';Q.ParamByName('I').AsInteger:=Id-I;Q.Open;Check((Q.FieldByName('ESTADO').AsString='RECHAZADO') and (Q.FieldByName('L').AsInteger=255),'E'+Tipo+' rechazo largo persistido en reserva');Q.Close;",
      "Q.SQL.Text:='SELECT INTENTOS,TRACK_ID,CHAR_LENGTH(MENSAJE) L FROM ECF_GASTO_ENVIO WHERE CIA_KEY=:I AND ENCF=:N';Q.ParamByName('I').AsInteger:=Id;Q.ParamByName('N').AsString:=Encf;Q.Open;Check((Q.FieldByName('INTENTOS').AsInteger=1) and (Q.FieldByName('TRACK_ID').AsString='QA-TRACK') and (Q.FieldByName('L').AsInteger=1024),'historial insertado atomico');Q.Close;T.Rollback;",
      "R.Estado:='ACEPTADO';R.Mensaje:='QA aceptado';PersistirResultadoEcfGasto(D,Id,Id,Tipo,Encf,R);",
      "R.Estado:='PENDIENTE';R.Mensaje:='QA consulta pendiente';PersistirResultadoEcfGasto(D,Id,Id,Tipo,Encf,R);",
      "T.StartTransaction;Q.SQL.Text:='SELECT ESTADO,INTENTOS FROM ECF_GASTO_ENVIO WHERE CIA_KEY=:I AND ENCF=:N';Q.ParamByName('I').AsInteger:=Id;Q.ParamByName('N').AsString:=Encf;Q.Open;Check((Q.FieldByName('ESTADO').AsString='ACEPTADO') and (Q.FieldByName('INTENTOS').AsInteger=3),'consulta no degrada aceptacion');Q.Close;T.Rollback;",
      "R.ENCF:='E'+Tipo+'9999999992';Conflict:=False;try PersistirResultadoEcfGasto(D,Id,Id,Tipo,Encf,R);except Conflict:=True;end;Check(Conflict,'e-NCF distinto rechazado');",
      "end;",
      "Data:=TIBDataSet.Create(nil);",
      "try",
      "Data.Database:=D;Data.Transaction:=T;Data.CachedUpdates:=True;",
      "Data.SelectSQL.Text:='SELECT ID,MENSAJE FROM ECF_RESERVA WHERE ID='+IntToStr(Id-1);",
      "Data.ModifySQL.Text:='UPDATE ECF_RESERVA SET MENSAJE=:MENSAJE WHERE ID=:OLD_ID';",
      "Data.Open;Data.Edit;Data.FieldByName('MENSAJE').AsString:='QA guardado confirmado';GuardarDatasetEcf(Data);",
      "Q.Close;Q.SQL.Text:='SELECT MENSAJE FROM ECF_RESERVA WHERE ID='+IntToStr(Id-1);Q.Open;Check(Q.FieldByName('MENSAJE').AsString='QA guardado confirmado','dataset confirma escritura');Q.Close;",
      "Data.Close;Data.ModifySQL.Text:='UPDATE ECF_RESERVA SET ID=NULL,MENSAJE=:MENSAJE WHERE ID=:OLD_ID';Data.Open;",
      "Data.Edit;Data.FieldByName('MENSAJE').AsString:='QA fallo provocado';Conflict:=False;",
      "try GuardarDatasetEcf(Data);except Conflict:=True;end;",
      "Check(Conflict,'dataset propaga fallo de persistencia');",
      "Q.SQL.Text:='SELECT MENSAJE FROM ECF_RESERVA WHERE ID='+IntToStr(Id-1);Q.Open;Check(Q.FieldByName('MENSAJE').AsString='QA guardado confirmado','fallo conserva dato confirmado');Q.Close;",
      "Data.Close;T.Rollback;",
      "finally Data.Free;end;",
      "R.ENCF:='E419999999993';Conflict:=False;try PersistirResultadoEcfGasto(D,Id,Id,'41',R.ENCF,R);except Conflict:=True;end;Check(Conflict,'reserva ausente revierte persistencia');",
      "WriteLn('GASTOS_PERSISTENCIA_QA=PASS');",
      "except on E:Exception do begin WriteLn('GASTOS_PERSISTENCIA_QA=FAIL ETAPA=',Stage,' ',E.Message);ExitCode:=1;end;end;",
      "finally",
      "if T.InTransaction then T.Rollback;",
      "if D.Connected then begin",
      "T.StartTransaction;Q.Close;Q.SQL.Text:='DELETE FROM ECF_GASTO_ENVIO WHERE CIA_KEY=:I';Q.ParamByName('I').AsInteger:=Id;Q.ExecSQL;",
      "Q.SQL.Text:='DELETE FROM ECF_RESERVA WHERE ID IN (:A,:B) AND HASH_DOC STARTING WITH :H';Q.ParamByName('A').AsInteger:=Id-1;Q.ParamByName('B').AsInteger:=Id-2;Q.ParamByName('H').AsString:='GASTO|CIA='+IntToStr(Id)+'|';Q.ExecSQL;T.Commit;",
      "end;Q.Free;T.Free;D.Free;S.Free;",
      "end;",
      "end."
    ]
  },
