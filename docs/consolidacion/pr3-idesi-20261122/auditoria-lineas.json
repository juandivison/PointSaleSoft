      "program GenerarGastosParidadQA;",
      "{$APPTYPE CONSOLE}",
      "uses SysUtils, Classes, IBDatabase, UGastoTxtBuilder;",
      "function Valor(const S,N:string):string;var P,F:Integer;",
      "begin P:=Pos(N+'=',S);if P=0 then raise Exception.Create('Configuracion ausente');Inc(P,Length(N)+1);F:=P;while (F<=Length(S)) and (S[F]<>#39) do Inc(F);Result:=Copy(S,P,F-P);end;",
      "var D:TIBDatabase;T:TIBTransaction;S:TStringList;B:TGastoTxtBuilder;R:TGastoTxtBuildResult;I:Integer;",
      "begin",
      "if ParamCount<>3 then Halt(2);",
      "D:=TIBDatabase.Create(nil);T:=TIBTransaction.Create(nil);S:=TStringList.Create;",
      "try",
      "S.LoadFromFile(ParamStr(1));D.DatabaseName:='localhost:'+ParamStr(2);D.SQLDialect:=1;D.LoginPrompt:=False;",
      "D.Params.Values['user_name']:=Valor(S.Text,'user_name');D.Params.Values['password']:=Valor(S.Text,'password');S.Clear;",
      "D.Connected:=True;T.DefaultDatabase:=D;T.Params.Add('read');T.Params.Add('read_committed');T.Params.Add('rec_version');T.StartTransaction;",
      "B:=TGastoTxtBuilder.Create(D,T);",
      "try",
      "for I:=2 to 3 do begin R:=B.GenerateGastosTxt(I,IncludeTrailingPathDelimiter(ParamStr(3))+'Gasto-'+IntToStr(I)+'.txt');WriteLn('PASS TXT QA TRN=',I,' TIPO=',R.TipoEcf);end;",
      "finally B.Free;end;",
      "T.Rollback;",
      "finally S.Free;T.Free;D.Free;end;",
      "end."
    ]
  },
