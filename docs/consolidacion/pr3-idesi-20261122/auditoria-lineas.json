      "using Microsoft.Extensions.Configuration;",
      "using System;",
      "namespace IdesiToolECF.Services.Gastos;",
      "public static class GastoArtifactOptions",
      "{",
      "// Ausencia habilita la descarga; false/0/no/off la deshabilitan.",
      "public static bool RetrieveSignedXmlOnAccept(IConfiguration configuration)",
      "{",
      "var value = configuration[\"DGII:RetrieveSignedXmlOnAccept\"]?.Trim();",
      "if (string.IsNullOrEmpty(value)) return true;",
      "if (bool.TryParse(value, out var enabled)) return enabled;",
      "if (value == \"1\" || value.Equals(\"yes\", StringComparison.OrdinalIgnoreCase)",
      "|| value.Equals(\"on\", StringComparison.OrdinalIgnoreCase)) return true;",
      "if (value == \"0\" || value.Equals(\"no\", StringComparison.OrdinalIgnoreCase)",
      "|| value.Equals(\"off\", StringComparison.OrdinalIgnoreCase)) return false;",
      "throw new InvalidOperationException(\"DGII:RetrieveSignedXmlOnAccept debe ser true o false.\");",
      "}",
      "}"
    ]
  },
