      "using System;",
      "namespace IdesiToolECF.Services.Gastos;",
      "public static class GastoFiscalState",
      "{",
      "public static string NormalizeToken(string? raw) => (raw ?? \"\").Trim().ToUpperInvariant() switch {",
      "\"ACEPTADO\" or \"ACEPTADO CONDICIONAL\" => \"ACEPTADO\",",
      "\"RECHAZADO\" => \"RECHAZADO\",",
      "\"EN PROCESO\" or \"EN_PROCESO\" or \"IN_PROCESS\" or \"PENDIENTE\" => \"IN_PROCESS\",",
      "\"NO ENCONTRADO\" or \"NO_ENCONTRADO\" or \"NOT_FOUND\" => \"NOT_FOUND\",",
      "_ => \"NO_CONFIRMADO\"",
      "};",
      "public static string FromResponse(string? raw, string? parsed)",
      "{",
      "// Un estado primario desconocido no se sustituye por inferencias del parser.",
      "return NormalizeToken(raw);",
      "}",
      "}"
    ]
  },
