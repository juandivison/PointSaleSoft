      "try",
      "S.LoadFromFile(ParamStr(1));D.DatabaseName:='localhost:'+ParamStr(2);D.SQLDialect:=1;D.LoginPrompt:=False;D.Params.Values['user_name']:=Valor(S.Text,'user_name');D.Params.Values['password']:=Valor(S.Text,'password');S.Clear;D.Connected:=True;",
      "T.DefaultDatabase:=D;T.Params.Add('read');T.Params.Add('read_committed');T.Params.Add('rec_version');T.StartTransaction;Q.Database:=D;Q.Transaction:=T;",
      "Base:='SELECT r.FACT_DESCBANCO,r.FACT_TITLAR,r.FACT_DESCNUMCTA FROM BANCOS_DET R WHERE r.CIA_KEY=:ciakey AND r.ACTIVAENFCT=1';",
      "Fila1:='SELECT 1,1,CAST(''BANCO QA UNO'' AS VARCHAR(40)),CAST(''TITULAR QA UNO'' AS VARCHAR(60)),CAST(''CUENTA-QA-001'' AS VARCHAR(50)) FROM RDB$DATABASE';",
      "Fila2:=' UNION ALL SELECT 1,0,''BANCO INACTIVO'',''TITULAR INACTIVO'',''NO-IMPRIMIR'' FROM RDB$DATABASE';",
      "Fila3:=' UNION ALL SELECT 2,1,''BANCO OTRA CIA'',''TITULAR OTRA CIA'',''CUENTA-OTRA-CIA'' FROM RDB$DATABASE';",
      "Abrir(Fila1+Fila2+Fila3,1);Check((L.Count=3)and(L[0]='BANCO QA UNO')and(L[2]='CUENTA-QA-001'),'solo cuenta marcada de la empresa');",
      "Abrir(Fila1+Fila2+Fila3,2);Check((L.Count=3)and(L[0]='BANCO OTRA CIA'),'aislamiento por empresa');",
      "Abrir(Fila1+Fila2+Fila3,99);Check(L.Count=0,'sin filas limpia datos anteriores');",
      "Abrir(Fila1+' UNION ALL SELECT 1,1,''BANCO QA DOS'',''TITULAR QA DOS'',''CUENTA-QA-002'' FROM RDB$DATABASE',1);Check((L.Count=7)and(L[4]='BANCO QA DOS')and(L[6]='CUENTA-QA-002'),'varias cuentas con nombre titular y numero');",
      "CargarLineasCuentasBanco(Q,L);Check(L.Count=7,'reimpresion no duplica lineas');",
      "Abrir('SELECT 1,1,CAST(NULL AS VARCHAR(40)),CAST(NULL AS VARCHAR(60)),CAST(NULL AS VARCHAR(50)) FROM RDB$DATABASE',1);Check(L.Count=0,'campos nulos no imprimen valores anteriores');",
      "Abrir('SELECT 1,CAST(NULL AS SMALLINT),CAST(''BANCO NO MARCADO'' AS VARCHAR(40)),CAST(''QA'' AS VARCHAR(60)),CAST(''NO-IMPRIMIR'' AS VARCHAR(50)) FROM RDB$DATABASE',1);Check(L.Count=0,'indicador nulo no autoriza impresion');",
      "Q.Close;T.Rollback;WriteLn('BANCO_AYACO_QA=PASS SIN_MODIFICACIONES');",
      "finally if T.InTransaction then T.Rollback;L.Free;S.Free;Q.Free;T.Free;D.Free;end;",
      "end."
    ]
  }
]